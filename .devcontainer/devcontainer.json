{
  "name": "betaflight devcontainer",
  "build": {
    "dockerfile": "containerfile",
    "context": "."
  },
  "privileged": true,
  "runArgs": [
     "--userns=host", // <== use this for docker
    //  "--userns=keep-id", // <== use this for podman
     "--volume=/dev:/dev"
  ],
  "remoteUser": "devpod",
  "features": {},
  // The WebFPVSimulator is cloned on create (no volume: commit and push sim
  // work, a rebuild starts from the remote). BF_BANK_SRC is where the sim's
  // bank overlay (scripts/bank-sync.sh) reads the bank mode sources from.
  "containerEnv": {
    "BF_BANK_SRC": "/workspaces/betaflight",
    "SIM_DIR": "/home/devpod/WebFPVSimulator",
    "SIM_REPO": "https://github.com/its-wobble/WebFPVSimulator.git",
    "SIM_BRANCH": "banked-mode-sim-2",
    // Virtual display started by start-xvfb.sh, so headless Chromium has WebGL
    "DISPLAY": ":99"
  },
  "postCreateCommand": "bash .devcontainer/setup-sim.sh",
  "postStartCommand": "bash .devcontainer/start-xvfb.sh",
  // WebFPVSimulator dev server (npm run serve)
  "forwardPorts": [8000]
}
